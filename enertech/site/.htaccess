# EnerTech Synergies — Apache configuration (shared hosting friendly)

ErrorDocument 404 /404.html
Options -Indexes

# ---- 301 redirects from the previous site so search rankings and old links survive ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS + www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.enertechsynergies.com%{REQUEST_URI} [L,R=301]

  RewriteRule ^aboutus\.php$                       /about.html [L,R=301]
  RewriteRule ^values\.php$                        /about.html#values [L,R=301,NE]
  RewriteRule ^meet-team\.php$                     /about.html#team [L,R=301,NE]
  RewriteRule ^csr\.php$                           /sustainability.html [L,R=301]
  RewriteRule ^careers\.php$                       /careers.html [L,R=301]
  RewriteRule ^contact\.php$                       - [L]
  RewriteRule ^oilgas\.php$                        /sectors/oil-and-gas.html [L,R=301]
  RewriteRule ^green-sustainable-technologies\.php$ /sectors/energy-transition.html [L,R=301]
  RewriteRule ^digital-world\.php$                 /sectors/digital-transformation.html [L,R=301]
  RewriteRule ^building-infrastructure\.php$       /sectors/infrastructure.html [L,R=301]
  RewriteRule ^laser-scanning\.php$                /sectors/laser-scanning.html [L,R=301]
  RewriteRule ^skilled-workers\.php$               /sectors/workforce-solutions.html [L,R=301]
  RewriteRule ^case-studies(-details)?\.php$       /projects.html [L,R=301]
  RewriteRule ^news(-details)?\.php$               /news.html [L,R=301]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# ---- Caching: long-lived for assets, short for HTML ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
